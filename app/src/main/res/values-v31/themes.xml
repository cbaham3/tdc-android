<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ shows a system splash first; keep it plain black so our
         logo animation starts from nothing (no icon flash). -->
    <style name="Theme.TDC" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:colorBackground">@color/black</item>
        <item name="android:colorAccent">@color/tdc_purple</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowSplashScreenBackground">@color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/blank</item>
    </style>
</resources>
